		<Compile Include="$(PkgPath)/CrtAIKnwLibApp/Schemas/KnwProviderConnection/KnwProviderConnection.cs" Condition="Exists('$(PkgPath)/CrtAIKnwLibApp/Schemas/KnwProviderConnection/KnwProviderConnection.cs')" />
