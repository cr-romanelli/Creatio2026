		<Compile Include="$(PkgPath)/CrtAIKnwLibApp/Schemas/KnwSourceStatus/KnwSourceStatus.cs" Condition="Exists('$(PkgPath)/CrtAIKnwLibApp/Schemas/KnwSourceStatus/KnwSourceStatus.cs')" />
		<Compile Include="$(PkgPath)/CrtAIKnwLibApp/Schemas/KnwSrcEventsOutbox/KnwSrcEventsOutbox.cs" Condition="Exists('$(PkgPath)/CrtAIKnwLibApp/Schemas/KnwSrcEventsOutbox/KnwSrcEventsOutbox.cs')" />
